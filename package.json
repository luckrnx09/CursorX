{
  "name": "cursorx",
  "version": "0.0.6",
  "description": "A modern cross-platform desktop app for cursor highlighting",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && cross-env NODE_ENV=development electron dist/main/main.js",
    "build": "npm run build:renderer && npm run build:main && npm run copy:meta",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/main/assets && cp -r src/main/assets/* dist/main/assets/",
    "copy:meta": "cp package.json dist/main/package.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "lint:all": "npm run lint:fix && npm run format",
    "lint:check": "npm run lint && npm run format:check",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cursor",
    "highlight",
    "click",
    "visualization",
    "electron",
    "desktop"
  ],
  "author": "CursorX Team",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^24.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.0",
    "shadcn": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.5.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "inversify": "^7.9.0",
    "lucide-react": "^0.545.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14"
  },
  "build": {
    "appId": "com.cursorx.app",
    "productName": "CursorX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/scripts",
        "to": "scripts"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "src/main/assets/icons/mac/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "src/main/assets/icons/win/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/main/assets/icons/png"
    },
    "publish": {
      "provider": "github",
      "owner": "luckrnx09",
      "repo": "CursorX"
    }
  }
}
